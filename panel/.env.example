# Copy to panel/.env and adjust. All vars are prefixed PANEL_.

# Admin login (CHANGE THESE)
PANEL_ADMIN_PASSWORD=changeme
PANEL_SECRET_KEY=please-generate-a-long-random-string

# Where the game server config/maps live (read-only, for the catalog).
# Default: ../bin/server relative to the repo.
# PANEL_SERVER_DIR=/path/to/brainout/bin/server

# The managed game container (offline Docker backend)
PANEL_GAME_CONTAINER=brainout-server
PANEL_GAME_IMAGE=brainout-server:offline
PANEL_TCP_PORT=36555
PANEL_UDP_PORT=36556
PANEL_HTTP_PORT=36557

# Optional: game server HTTP base URL for live status (Phase 2)
# PANEL_STATUS_URL=http://brainout-server:36557
