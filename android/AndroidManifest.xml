<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- package / versionCode / versionName / uses-sdk are declared in
         android/build.gradle (AGP 8 requirement). -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The client talks to a user-supplied server over plain TCP/UDP/HTTP
         (default ports 36555/36556/36557). Android 9+ blocks cleartext HTTP by
         default, so allow it for the direct-connect / self-hosted use case. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/GdxTheme" >
        <activity
            android:name="com.desertkun.brainout.android.AndroidLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Direct-connect deep link: brainout://<base64 of host;tcp;udp;http>
                 Opening such a link launches the client straight into the
                 connection flow (see AndroidLauncher / IntroMenu). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brainout" />
            </intent-filter>
        </activity>
    </application>

</manifest>
